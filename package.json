{
  "name": "ugk-moe-agent",
  "version": "0.1.0",
  "description": "ugk-moe-agent — 专家 agent 集合 + MCP 网关,每个专家是一个懂一件事的独立 ugk 实例",
  "type": "module",
  "license": "MIT",
  "author": "ugk-moe-agent contributors",
